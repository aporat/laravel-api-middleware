{
  "name": "aporat/laravel-api-middleware",
  "description": "A Laravel package for API middleware including trust proxies, SSL, and no-cache.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Aporat\\Laravel\\ApiMiddleware\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "illuminate/config": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "symfony/http-foundation": "^8.0",
    "symfony/http-kernel": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "orchestra/testbench": "^11.0",
    "laravel/pint": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Aporat\\Laravel\\ApiMiddleware\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-ci": "phpunit --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
    "check": "vendor/bin/pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aporat\\Laravel\\ApiMiddleware\\ApiMiddlewareServiceProvider"
      ]
    }
  }
}
